# ---------------------------------------------------------------------------
# Dentin environment
# Copy to .env.local for local dev. In production set these in Vercel:
#   Project → Settings → Environment Variables
# ---------------------------------------------------------------------------

# --- Auth gate ---------------------------------------------------------------
# Skip sign-in and setup and open straight on Today. Already the default while
# Supabase is unconfigured; set this to true to keep skipping the gate after a
# live project is connected. /welcome and /onboarding stay reachable by URL.
VITE_BYPASS_AUTH=true

# --- Supabase (client-side; safe to expose, protected by Row Level Security) --
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Web Push (client needs the public key only) ----------------------------
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ---------------------------------------------------------------------------
# SERVER-ONLY — never prefix these with VITE_, they must not reach the browser
# ---------------------------------------------------------------------------

# Service-role key: bypasses RLS. Used by /api serverless functions only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push keypair — generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:alerts@yourpractice.com

# Shared secret Vercel Cron sends as `Authorization: Bearer <token>`
CRON_SECRET=generate-a-long-random-string

# --- Stripe (Dentin's own subscription billing) ------------------------------
# Secret key from Stripe → Developers → API keys. Test mode first (sk_test_…),
# then the live key once checkout is verified end to end.
STRIPE_SECRET_KEY=sk_test_your-key
# Recurring Prices for the Dentin plan (Products → your product → the price →
# "API ID", starts with price_). Two ways to pay for the same plan:
#   Annual  — $2,160 / location / year (the 10% discount is baked into this
#             price so promo codes still apply on top). Signup defaults here.
#   Monthly — $200 / location / month.
STRIPE_PRICE_ID_ANNUAL=price_your-annual-price
STRIPE_PRICE_ID_MONTHLY=price_your-monthly-price
# Legacy fallback: used for the monthly plan if STRIPE_PRICE_ID_MONTHLY is
# unset. Safe to leave in place from an earlier setup.
STRIPE_PRICE_ID=price_your-monthly-price
# Signing secret for the webhook endpoint /api/billing/webhook
# (Developers → Webhooks → your endpoint → Signing secret, whsec_…).
STRIPE_WEBHOOK_SECRET=whsec_your-signing-secret
# Free trial length in days for new subscriptions (0 disables the trial).
# The card is collected at checkout and charged automatically at trial end.
STRIPE_TRIAL_DAYS=7
